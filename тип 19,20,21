def f(s,c,end):
    if s >= 125 or c > end:
        return c % 2 == end % 2

    h = [f(s+2,c+1,end), f(s+4,c+1,end), f(s*2,c+1,end)]

    if (c+1)%2 == end % 2:
        return any(h)
    else:
        return all(h)

print(19, [s for s in range(1,125) if f(s,0,2)])
print(20, [s for s in range(1,125) if not f(s,0,1) and f(s,0,3)])
print(21, min([s for s in range(1,125) if not f(s,0,2) and f(s,0,4)]))

def f(x,y):
    A = 3 <= x <= 60
    B = 177 % x == 0 and x not in [1,177]
    C = y % x == 0 and x not in [1,y]
    return C <= (A and (not B))

for y in range(1,10000)[::-1]:
    D = [e for e in range(2,y) if y % e == 0]
    if D and all(f(x,y) for x in range(1,10000)):
        print(y)
        break

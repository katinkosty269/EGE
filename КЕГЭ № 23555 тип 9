k = 0
for s in open('9_23555 (4).csv'):
    a = [int(x) for x in s.split(',') ]
    a1 = [x for x in a if a.count(x) == 1]
    a2 = [x for x in a if a.count(x) == 2]
    a3 = [x for x in a if a.count(x) == 3]
    if len(a1) == 2 and len(a2) == 2 and len(a3) == 3 and (max(a2+a3))>max(a1):
        k += 1
print(k)
